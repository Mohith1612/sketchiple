# Port the uWS server listens on
PORT=3001

# Optional comma-separated allow-list for WebSocket Origin validation
# Example: WS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# If unset, loopback localhost origins are allowed for development.

# Maximum accepted awareness payload bytes before rejection
# WS_MAX_AWARENESS_UPDATE_BYTES=131072

# Backpressure guardrails
# WS_MAX_BUFFERED_BYTES=262144
# WS_MAX_QUEUED_MESSAGES=64
# WS_DRAIN_BATCH_SIZE=64
